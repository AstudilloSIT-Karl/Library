
@model library.Models.MemberDetails

@{
    ViewData["Title"] = Model.Member.FullName;
}

<div class="p-4 mb-4 bg-white rounded-4 shadow-sm">
    <h1>@Model.Member.FullName</h1>

    <p class="text-muted">
        @Model.Member.MemberType ·
        @(Model.Member.Email ?? "No email")
    </p>

    <a asp-controller="Members"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Members
    </a>
</div>

<h2 class="h5 mt-4">📚 Borrowing History</h2>

@if (Model.Loans.Count == 0)
{
    <div class="alert alert-info">
        This member has never borrowed a book.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Book</th>
                <th>Loaned</th>
                <th>Returned</th>
                <th>Days Allowed</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>@loan.BookTitle</td>
                    <td>@loan.LoanedOn</td>
                    <td>
                        @(loan.ReturnedOn?.ToString() ?? "Not returned")
                    </td>
                    <td>@loan.DaysAllowed</td>
                    <td>@loan.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
