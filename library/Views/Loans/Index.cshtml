
@model List<library.Models.LoanView>

@{
    ViewData["Title"] = "Library Loans";
}

<div class="p-4 mb-4 bg-white rounded-4 shadow-sm">
    <h1>📚 Library Loans</h1>
    <p class="text-muted">
        Manage borrowed and returned books.
    </p>

    <a asp-controller="Loans"
       asp-action="Borrow"
       class="btn btn-primary">
        ➕ Borrow a Book
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Loan ID</th>
            <th>Member</th>
            <th>Book Title</th>
            <th>Loan Date</th>
            <th>Return Date</th>
            <th>Days Allowed</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.LoanId</td>
                <td>@loan.MemberName</td>
                <td>@loan.BookTitle</td>
                <td>@loan.LoanedOn</td>
                <td>
                    @(loan.ReturnedOn?.ToString() ?? "Not returned")
                </td>
                <td>@loan.DaysAllowed</td>

                <td>
                    @if (loan.Status == "Overdue")
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                    else if (loan.Status == "Returned")
                    {
                        <span class="badge bg-secondary">Returned</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Out</span>
                    }
                </td>

                <td>
                    @if (loan.ReturnedOn == null)
                    {
                        <form asp-action="Return"
                              asp-route-id="@loan.LoanId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-outline-success">
                                Return
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Completed</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
