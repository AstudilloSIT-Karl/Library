@model library.Models.Note
@{
    ViewData["Title"] = "Delete Note";
}

<h1 class="mb-3">Delete Note</h1>

<div class="card card-body" style="max-width:40rem">
    <p>Are you sure you want to delete this note?</p>

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Body</dt>
        <dd class="col-sm-9">
            <span style="white-space:pre-wrap">@(Model.Body ?? "—")</span>
        </dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">
            @Model.CreatedOn.ToString("yyyy-MM-dd")
        </dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.NoteId" method="post">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
