@model List<library.Models.Note>
@{
    ViewData["Title"] = "Notepad";
}

<h1 class="mb-2">Library Notepad</h1>
<p class="text-muted">@Model.Count notes</p>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">+ Add a note</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:5rem">ID</th>
            <th style="width:14rem">Title</th>
            <th>Body</th>
            <th style="width:9rem">Created</th>
            <th style="width:10rem">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td>@note.NoteId</td>
                <td>@note.Title</td>
                <td>
                    <span style="white-space:pre-wrap">@(note.Body ?? "—")</span>
                </td>
                <td>@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@note.NoteId"
                       class="btn btn-sm btn-outline-secondary mb-1">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@note.NoteId"
                       class="btn btn-sm btn-outline-danger mb-1">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
