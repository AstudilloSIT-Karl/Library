@model library.Models.Note
@{
    ViewData["Title"] = "Edit Note";
}

<h1 class="mb-3">Edit Note</h1>

<form asp-action="Edit" method="post"
      class="card card-body" style="max-width:40rem">

    <input type="hidden" asp-for="NoteId" />

    <p class="text-muted">
        Created on @Model.CreatedOn.ToString("yyyy-MM-dd")
    </p>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="100" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Body" class="form-label">Note body (optional)</label>
        <textarea asp-for="Body" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Body" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
